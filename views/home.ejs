<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PhotoSelector | <%= title %>
    </title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/styles.css">
</head>

<body class="min-h-screen flex flex-col bg-gradient-to-br from-[#e0e7ff] to-[#f0eaff] text-gray-800 font-sans">
    <nav class="bg-white shadow-md">
        <div class="container mx-auto px-4 sm:px-6 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <a href="/" class="flex items-center gap-3 group">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 60" width="160" height="50" role="img"
                            aria-labelledby="title">
                            <title id="title">Capture Creation Logo</title>
                            <defs>
                                <linearGradient id="tealGrad" x1="0" x2="1">
                                    <stop offset="0%" stop-color="#0d9488" />
                                    <stop offset="100%" stop-color="#14b8a6" />
                                </linearGradient>
                            </defs>

                            <!-- Camera body -->
                            <rect x="0" y="15" width="50" height="30" rx="8" fill="url(#tealGrad)" />
                            <!-- Lens -->
                            <circle cx="25" cy="30" r="8" fill="white" opacity="0.2" />
                            <circle cx="25" cy="30" r="5" fill="url(#tealGrad)" />
                            <!-- Flash -->
                            <rect x="15" y="10" width="12" height="6" rx="2" fill="#0f766e" />
                            <!-- Shutter dot -->
                            <circle cx="32" cy="25" r="1.5" fill="#fff" />

                            <!-- Text -->
                            <text x="65" y="32" font-family="Poppins, sans-serif" font-size="20" font-weight="700"
                                fill="#0f766e">
                                Capture
                            </text>
                            <text x="65" y="50" font-family="Poppins, sans-serif" font-size="16" font-weight="500"
                                fill="url(#tealGrad)">
                                Creation
                            </text>
                        </svg>
                    </a>
                </div>
                <div class="flex items-center">
                    <ul class="flex items-center space-x-6">
                        <% if (user) { %>
                            <li><span class="font-semibold text-gray-700">Welcome, <%= user.name %></span></li>
                            <% if (user.role==='photographer' ) { %>
                                <li><a href="/admin/dashboard"
                                        class="text-gray-800 hover:text-[#4753eb] transition-colors duration-200">Dashboard</a>
                                </li>
                                <% } %>
                                    <li><a href="/logout"
                                            class="bg-red-600 text-white px-3 py-1 sm:px-4 sm:py-2 rounded-md hover:bg-red-700 transition-colors duration-200">Logout</a>
                                    </li>
                                    <% } else { %>
                                        <li><a href="/login"
                                                class="text-gray-800 hover:text-[#4753eb] transition-colors duration-200">Login
                                                </a></li>
                                        <li><a href="/signup"
                                                class="bg-teal-500 text-white px-4 py-2 rounded-md hover:bg-[#803beb] transition-colors duration-200">Sign
                                                Up</a></li>
                                        <% } %>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

  
    <main class="flex-grow flex items-center justify-center p-4 sm:p-6">
        <div
            class="max-w-4xl w-full bg-white p-8 md:p-16 rounded-xl shadow-2xl text-center border border-gray-100 transform hover:scale-103 transition-all duration-500 ease-in-out">
            <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold  mb-6 leading-tight">Your Event Photos, <br
                    class="hidden sm:inline"> <span class="text-teal-600">Your Choice</span></h1>
            <p class="text-lg sm:text-xl md:text-2xl text-gray-700 mb-10 max-w-2xl mx-auto">Seamless photo sharing for
                photographers, intuitive selection for customers.</p>

            <% if (user) { %>
                <% if (user.role==='photographer' ) { %>
                    <a href="/admin/dashboard"
                        class="inline-block bg-[#4753eb] text-white font-bold py-4 px-10 rounded-full text-xl hover:bg-[#803beb] transform hover:-translate-y-1 transition-all duration-300 shadow-lg">Go
                        to Your Dashboard</a>
                    <% } else { %>
                        <!-- Customer link input form -->
                        <form id="link-form" class="mt-8 max-w-xl mx-auto space-y-4">
                            <label for="eventLink" class="block text-lg sm:text-xl text-gray-700 font-semibold mb-3">Have an event
                                link? Paste it here to view your photos:</label>
                            <div class="flex flex-col sm:flex-row gap-4">
                                <input type="text" id="eventLink"
                                    placeholder="e.g., http://yourdomain.com/event/xyz123"
                                    class="flex-grow px-4 py-2 sm:px-6 sm:py-3 border border-gray-300 rounded-full focus:outline-none focus:ring-2 focus:ring-[#4753eb] text-base sm:text-lg shadow-sm"
                                    required>
                               <button type="submit"
                                    class="bg-[#803beb] text-white font-bold py-2 px-6 sm:py-3 sm:px-8 rounded-full text-base sm:text-lg hover:bg-[#4753eb] transform hover:-translate-y-0.5 transition-all duration-300 shadow-md">
                                    View Photos
                                </button>
                            </div>
                            <div id="link-error" class="text-red-500 mt-2 text-base"></div>
                        </form>
                        <% } %>
                            <% } else { %>
                                <div class="flex flex-col sm:flex-row justify-center gap-6 mt-10">
                                    <a href="/login"
                                        class="inline-block bg-gray-700 text-white font-bold py-4 px-10 rounded-full text-xl hover:bg-gray-900 transform hover:-translate-y-1 transition-all duration-300 shadow-lg">Login</a>
                                 <a href="/signup"
                                        class="inline-block bg-teal-500 text-white font-bold py-4 px-10 rounded-full text-xl hover:bg-[#803beb] transform hover:-translate-y-1 transition-all duration-300 shadow-lg">Sign
                                        Up as Photographer</a>
                                </div>
                                <% } %>
        </div>
    </main>

    <footer class="bg-white shadow-inner p-4 text-center text-gray-600 text-sm mt-auto">
        &copy; 2025 Capture Creation. All rights reserved.
    </footer>

    <script>
        const linkForm = document.getElementById('link-form');
        const linkInput = document.getElementById('eventLink');
        const linkError = document.getElementById('link-error');

        if (linkForm) {
            linkForm.addEventListener('submit', (e) => {
                e.preventDefault();
                linkError.textContent = ''; // Clear previous errors

                const linkValue = linkInput.value.trim();
                if (!linkValue) {
                    linkError.textContent = 'Please enter an event link.';
                    return;
                }

                // Basic URL validation
                try {
                    const url = new URL(linkValue);
                    if (url.pathname.startsWith('/event/')) {
                        const uniqueLink = url.pathname.split('/').pop();
                        if (uniqueLink) {
                            location.assign(`/event/${uniqueLink}`);
                        } else {
                            linkError.textContent = 'Invalid event link format. Please ensure it has a unique ID.';
                        }
                    } else {
                        linkError.textContent = 'Invalid event link. It should start with /event/.';
                    }
                } catch (error) {
                    linkError.textContent = 'Please enter a valid URL.';
                }
            });
        }
    </script>
</body>

</html>