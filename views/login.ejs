<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body class="flex flex-col min-h-screen justify-center item-center ">
    <div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-lg">
        <h2 class="text-3xl font-bold text-center mb-6">Login Your Account</h2>
        <form id="login_form">
           
            <div class="mb-4">
                <label class="block text-gray-700 font-semibold mb-2" for="email">Email Address</label>
                <input class="w-full border px-4 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" type="email" , name="email" , id="email" required>
            </div>
            <div class="mb-4">
                <label class="block text-gray-700 font-semibold mb-2" for="password">password</label>
                <input class="w-full border px-4 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500" type="password" , name="password" , id="password" required>
            </div>
            
            <div class="text-red-500 mb-4 text-sm error"></div>
           <button type="submit" class="w-full bg-teal-600 text-white font-bold py-3 rounded-lg hover:bg-teal-700 transition duration-300">Log in</button>
        </form>
        <p class="text-center mt-4">Create a new account? <a href="/signup" class="text-teal-600 hover:underline">Sign up</a></p>
    </div>
    <script>
    const form = document.querySelector('#login_form')
    const errDiv = document.querySelector('.error')

    form.addEventListener('submit' , async(e)=>{
        e.preventDefault();

        errDiv.textContent = '';

        const email = form.email.value;
        const password = form.password.value;

        try{
            const res = await fetch('/login' , {
                method:'POST',
                body:JSON.stringify({email,password}),
                headers:{'Content-type':'application/json'}
            })

            const data = await res.json()
            if(data.errors){
                errDiv.textContent = 'invalid email and password'
            }
            if(data.redirect){
                location.assign(data.redirect)
            }
        }
        catch (err) {
            console.log(err);
        }
    });
</script>
</body>

</html>