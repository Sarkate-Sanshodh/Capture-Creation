<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Photoselector | <%= title %></title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="stylesheet" href="/stylesheet/style.css">
</head>

<body class="bg-gray-50 text-gray-800 font-sans">

  <!-- NAVBAR -->
  <nav class="bg-white/90 backdrop-blur-md border-b border-gray-100 sticky top-0 z-50">
    <div class="container mx-auto flex items-center justify-between px-6 py-3">
      
      <!-- 🌿 Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 60" width="160" height="50" role="img" aria-labelledby="title">
          <title id="title">Capture Creation Logo</title>
          <defs>
            <linearGradient id="tealGrad" x1="0" x2="1">
              <stop offset="0%" stop-color="#0d9488" />
              <stop offset="100%" stop-color="#14b8a6" />
            </linearGradient>
          </defs>

          <!-- Camera body -->
          <rect x="0" y="15" width="50" height="30" rx="8" fill="url(#tealGrad)" />
          <!-- Lens -->
          <circle cx="25" cy="30" r="8" fill="white" opacity="0.2" />
          <circle cx="25" cy="30" r="5" fill="url(#tealGrad)" />
          <!-- Flash -->
          <rect x="15" y="10" width="12" height="6" rx="2" fill="#0f766e" />
          <!-- Shutter dot -->
          <circle cx="32" cy="25" r="1.5" fill="#fff" />

          <!-- Text -->
          <text x="65" y="32" font-family="Poppins, sans-serif" font-size="20" font-weight="700" fill="#0f766e">
            Capture
          </text>
          <text x="65" y="50" font-family="Poppins, sans-serif" font-size="16" font-weight="500" fill="url(#tealGrad)">
            Creation
          </text>
        </svg>
      </a>

      <!-- Desktop Menu -->
      <ul class="hidden md:flex items-center space-x-8 text-lg font-medium">
        <% if(user) { %>
          <li><span class="font-semibold text-teal-600">Welcome, <%= user.name.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') %></span></li>
          <% if(user.role==='photographer') { %>
            <li><a href="/admin/dashboard" class="text-gray-700 hover:text-teal-600 transition-colors">Dashboard</a></li>
          <% } %>
          <li>
            <a href="/logout" class="bg-teal-600 text-white px-4 py-2 rounded-md shadow hover:bg-teal-700 transition-all">Logout</a>
          </li>
        <% } else { %>
          <li><a href="/login" class="text-gray-700 hover:text-teal-600 transition-colors">Login</a></li>
          <li>
            <a href="/signup" class="bg-gradient-to-r from-teal-600 to-teal-400 text-white px-4 py-2 rounded-md shadow hover:from-teal-700 hover:to-teal-500 transition-all">
              Signup
            </a>
          </li>
        <% } %>
      </ul>

      <!-- Mobile Menu Button -->
      <button id="menu-btn" class="md:hidden flex items-center justify-center w-10 h-10 rounded-md hover:bg-gray-100">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6 text-gray-700">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Dropdown -->
    <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100">
      <ul class="flex flex-col items-center py-3 space-y-4 text-lg">
        <% if(user) { %>
          <li><span class="font-semibold text-teal-600">Welcome, <%= user.name.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') %></span></li>
          <% if(user.role==='photographer') { %>
            <li><a href="/admin/dashboard" class="text-gray-700 hover:text-teal-600 transition-colors">Dashboard</a></li>
          <% } %>
          <li><a href="/logout" class="bg-teal-600 text-white px-4 py-2 rounded-md shadow hover:bg-teal-700 transition-all">Logout</a></li>
        <% } else { %>
          <li><a href="/login" class="text-gray-700 hover:text-teal-600 transition-colors">Login</a></li>
          <li><a href="/signup" class="bg-gradient-to-r from-teal-600 to-teal-400 text-white px-4 py-2 rounded-md shadow hover:from-teal-700 hover:to-teal-500 transition-all">Signup</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

   <main class="container mx-auto px-6 py-8 flex-grow">
  <!-- Mobile Toggle Script -->
  <script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  </script>

</body>

</html>
